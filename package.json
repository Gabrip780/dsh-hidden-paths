    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "security",
    "secrets",
    "env",
    "dotenv",
    "credentials",
    "redaction",
    "agent",
    "guard",
    "permissions"
  ],
  "license": "MIT",
  "author": "Pau Gabriele",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabrip780/dsh-hidden-paths.git"
  },
  "homepage": "https://github.com/Gabrip780/dsh-hidden-paths#readme",
  "bugs": {
    "url": "https://github.com/Gabrip780/dsh-hidden-paths/issues"
  },
  "engines": {
    "node": ">=18"
  },
